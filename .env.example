# Firebase service account key (Project settings > Service accounts > Generate new private key).
# Paste the JSON on ONE line, or base64-encode it:  base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase Web API key (Project settings > General > Web API Key).
FIREBASE_WEB_API_KEY=

# Optional
# FIREBASE_PROJECT_ID=           # defaults to project_id from the service account
# FIRESTORE_DATABASE_ID=(default)
# USERS_COLLECTION=users
# ALLOWED_ORIGINS=*              # e.g. https://myapp.com,http://localhost:3000
# PORT=8080                      # local server only
